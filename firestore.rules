rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 로그인 포함 로그인 사용자는 users 하위 읽기·쓰기 허용
    // (사용자 1~2명, 개인정보 없음 전제 — docs/SPEC.md 6장)
    match /users/{userId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
